      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"obsidian-mcp\", deployment_environment_name=\"$env\"} | tool != \"\" | status=\"error\" [$__range])) / sum(count_over_time({service_name=\"obsidian-mcp\", deployment_environment_name=\"$env\"} | tool != \"\" [$__range]))",
          "queryType": "instant",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",

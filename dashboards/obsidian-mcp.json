      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=\"obsidian-mcp\", deployment_environment_name=\"$env\"} | tool != \"\" | unwrap duration_ms [$__auto]) by (tool)",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "{{tool}}"

{
  "uid": "obsidian-mcp",
  "title": "Obsidian MCP",
  "description": "Vault-native Obsidian MCP server: health, security, vault activity and Quartz publishing.",
  "tags": [
    "obsidian",
    "mcp",
    "obsidian-mcp"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "custom",
        "label": "Environment",
        "query": "production,local",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "local",
            "value": "local",
            "selected": false
          }
        ],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Restarts",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "target": {
          "expr": "{service_name=\"obsidian-mcp\", deployment_environment_name=\"$env\"} |= \"server started\"",
          "queryType": "range",
          "refId": "Anno"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Is it healthy?",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Tool calls",
      "id": 2,
      "description": "Every tool invocation in the selected range.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"obsidian-mcp\", deployment_environment_name=\"$env\"} | tool != \"\" [$__range]))",
          "queryType": "instant",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Errors",
      "id": 3,
      "description": "Tool calls that raised. Includes rejected paths and refused stale writes, which are the server working correctly.",

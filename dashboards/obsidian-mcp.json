      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "max by (vault) (last_over_time({service_name=\"obsidian-mcp\", deployment_environment_name=\"$env\"} | notes != \"\" | unwrap notes [$__range]))",
          "queryType": "instant",
          "refId": "A",

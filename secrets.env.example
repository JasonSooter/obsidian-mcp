# Copy to secrets.env (gitignored) and fill in. This file holds real secrets;
# keep it out of git and out of any committed compose .env. The non-secret
# settings (OBSIDIAN_VAULTS etc.) are listed in the README.

# --- Login ------------------------------------------------------------------
# Authentication is OAuth 2.1. The server REFUSES TO START without both factors
# below: the login page is the only thing between the public internet and the
# vault, so failing closed is deliberate.

# Minimum 12 characters.
#   openssl rand -base64 24
OBSIDIAN_MCP_LOGIN_PASSWORD=

# Base32, as an authenticator shows it -- copy the 'setup key' / secret, NOT
# the 6-digit code.
OBSIDIAN_MCP_TOTP_SECRET=

# --- Telemetry (optional) ---------------------------------------------------
# Ships logs over OTLP, e.g. to Grafana Cloud, which dashboards/obsidian-mcp.json reads.
# Grafana's OTLP setup wizard (Home -> Connections -> Add new connection ->
# OpenTelemetry) generates both lines.
#
# Leave blank to run without telemetry: the server logs to stdout and serves
# normally. An unreachable observability backend must never stop the vault
# being served.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# --- Quartz publishing (only when QUARTZ_ENABLED=true) ----------------------
# A deploy key scoped to the Quartz repo ONLY. Never a personal access token:
# a stolen deploy key writes to a repo that is already public, while a stolen
# PAT is an account compromise.
QUARTZ_SSH_KEY_PATH=/run/secrets/quartz_deploy_key
